# ==============================================================================
# Lapor-Aman Environment Configuration Template (v2.0)
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# ==============================================================================

# Database (PostgreSQL / Neon) - Required in production
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/lapor_aman?sslmode=require"

# JWT Signing Secret (Server-Side ONLY, >= 32 characters random)
JWT_SECRET="replace-with-cryptographically-random-32-plus-char-jwt-secret"

# AES-256-GCM PII Encryption Key (Server-Side ONLY, >= 32 characters random)
SERVER_ENCRYPTION_KEY="replace-with-cryptographically-random-32-plus-char-aes-key"

# Admin Emails (Comma-separated allowlist)
ADMIN_EMAILS="admin@example.com,verifier@example.com"

# Cloudflare Turnstile CAPTCHA
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="replace-with-turnstile-secret-key"
# Optional comma-separated hostname allowlist for Turnstile verification
ALLOWED_TURNSTILE_HOSTNAMES="localhost,lapor-aman.example.com"

# OpenRouter AI Configuration (Server-Side ONLY)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash-lite"

# Direct Google Gemini API Key (Fallback via @google/genai, Server-Side ONLY)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
